[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info
ignore =
    E203,  # whitespace before ':'
    E266,  # too many leading '#' for block comment
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator
    F401,  # imported but unused (allowed in __init__.py)
per-file-ignores =
    __init__.py:F401  # Allow unused imports in __init__.py
max-complexity = 10
select = E,W,F
# F841: local variable assigned but never used - NOT IGNORED, will be caught
# F401: imported but unused - ignored except in __init__.py
# E501: line too long - handled by max-line-length=120

